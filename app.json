{
  "expo": {
    "name": "Trust Loop",
    "slug": "trust-loop-wallets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/trustloop-logo.png",
    "scheme": "trustloopwallets",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/trust-loop-foreground.png",
        "backgroundImage": "./assets/images/trust-loop-background.png",
        "monochromeImage": "./assets/images/trust-loop-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.breilerk.trustloopwallets"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/trustloop-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5d62ad4-a497-4f64-95c9-47b170f811b5"
      }
    }
  }
}
